# Normalize text to LF in the repository; keep binaries untouched.
* text=auto eol=lf

# Explicit binary types (never normalize / never diff as text)
*.lib binary
*.dll binary
*.pdb binary
*.exe binary
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.tga binary
*.uasset binary
*.umap binary
*.locres binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
